  "description": "Internal payroll & salary slip system — Arka Infotech Software Solutions LLP",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:migrate": "npm run prisma:migrate --workspace=backend",
    "backend:seed": "npm run prisma:seed --workspace=backend",
    "backend:studio": "npm run prisma:studio --workspace=backend"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@5.1.1": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "puppeteer@23.11.1": true
  }
}
